# Variables consumed by docker-compose.prod.yml itself (Compose reads a
# `.env` file from this directory automatically when run from here, e.g.
# `docker compose -f docker-compose.prod.yml up`). Copy to `.env` and fill in
# real values — none of the values below are real, and this .env.example is
# the only one of the two files meant to be committed (see ../.gitignore).
#
# This is separate from ../.env.example, which configures the API process
# itself when run directly (`uvicorn app.main:app`, outside Compose).

ENVIRONMENT=production

# Postgres
DB_PASSWORD=replace-with-a-strong-password

# JWT — required; without a real value here, app/core/config.py's
# assert_production_ready() refuses to start (see app/main.py).
JWT_SECRET=replace-with-a-long-random-string

# CORS — comma-separated list of real deployed dashboard origin(s).
CORS_ORIGINS=https://your-dashboard.example.com

# LiveKit — same key/secret pair the `livekit` service is given via
# LIVEKIT_KEYS (see docker-compose.prod.yml and infra/livekit.yaml).
LIVEKIT_URL=wss://livekit.your-domain.example.com
LIVEKIT_API_KEY=replace-with-a-real-key
LIVEKIT_API_SECRET=replace-with-a-real-secret

# S3 / MinIO
S3_BUCKET=mcam-recordings
S3_ACCESS_KEY=replace-with-a-real-access-key
S3_SECRET_KEY=replace-with-a-real-secret-key
