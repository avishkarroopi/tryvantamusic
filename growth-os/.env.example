# Growth OS — environment variables (Phase 23).
# Copy to .env and fill in real values. NEVER commit .env or real secrets.
# Every var below is documented with what breaks/degrades if it's missing --
# this system is designed to degrade gracefully (log "credential required",
# never fake success) rather than crash, EXCEPT where noted as required.

# ---------- Supabase (REQUIRED — app and worker both fail to start without these) ----------
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key, server-side only (bypasses RLS). Lovable Cloud does NOT
# expose this, by design, permanently (confirmed directly with Lovable) --
# leave empty. A few pre-existing routes that assumed it (leads/capture,
# google oauth callback) were already broken before this build; not this
# build's regression, just documenting it here since it's the same root cause.
SUPABASE_SERVICE_ROLE_KEY=
# Worker identity (REQUIRED for growth-os-worker) — a dedicated Supabase Auth
# user, not a service-role bypass. Create once via the normal signup endpoint,
# confirm its email and grant it 'admin' via user_roles directly over SQL
# (see growth-os-worker/README.md), then set its real password here.
# Verified working end-to-end 2026-09-02.
SUPABASE_WORKER_EMAIL="growth-os-worker@<your-project-ref>.internal"
SUPABASE_WORKER_PASSWORD=
# Client-side mirrors (Vite exposes only VITE_-prefixed vars to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Lovable AI Gateway (platform-injected in production — do not set locally) ----------
# LOVABLE_API_KEY is injected by the Lovable platform at runtime. Do not add
# it here; it will not exist in a local .env, and ai.server.ts/
# embeddings.server.ts both throw a clear "Missing LOVABLE_API_KEY" error
# rather than fake a completion when it's absent.

# ---------- Meta (Facebook Page + Instagram — organic) ----------
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ---------- Meta Marketing API (paid ads — Phase 6) ----------
# Both required for meta-ads.server.ts to do anything beyond returning
# missing_env errors. MARKETING_API_TOKEN needs `ads_management` permission
# on the Meta app; META_AD_ACCOUNT_ID is the numeric ad account id (no "act_" prefix).
MARKETING_API_TOKEN=
META_AD_ACCOUNT_ID=

# ---------- WhatsApp Business Cloud ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ---------- Google — unified OAuth connection ----------
# One connection covers Ads/GA4/Search Console/Business Profile/Gmail (see
# src/lib/google-integration/scopes.ts's GOOGLE_SCOPES) — there is no
# separate refresh token or service-account JSON per product in this
# architecture. Someone must complete the OAuth consent flow in the app
# (creates a row in google_integrations) before ANY of Phase 7/8/9/GBP/Gmail
# features work, regardless of these env vars being set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ---------- Google Ads (Phase 7 — on top of the unified Google connection) ----------
GOOGLE_ADS_DEVELOPER_TOKEN=
# Only needed if this Google account manages accounts under an MCC (manager account).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------- Search Console (Phase 9) ----------
# Optional sanity check: set to the real production domain once verified in
# Search Console. The only site discovered so far during this deployment's
# history is this tool's OWN preview URL, not the production site — see
# search-console.server.ts's module comment. Leaving this unset means the
# mismatch is flagged passively (any *.lovable.app site is flagged) rather
# than checked against a known-correct value.
GSC_EXPECTED_SITE_URL=

# ---------- Keyword/SERP tracking (Phase 12) ----------
# Used to identify "our" ranking position among SERP results — should match
# the real production domain (e.g. music.tryvanta.in or muziclly.com).
PRIMARY_DOMAIN=muziclly.com

# ---------- Research / SEO / competitor intelligence (already real) ----------
TAVILY_API_KEY=
SERPAPI_KEY=
FIRECRAWL_API_KEY=

# ---------- growth-os-worker process tuning (Phase 2 — optional, sane defaults apply) ----------
WORKER_TICK_INTERVAL_MS=30000
WORKER_HEALTH_PORT=8787
