# Copy to .env.local for local dev, and set the same keys in your hosting
# provider's dashboard (Vercel: Project -> Settings -> Environment Variables)
# for production. Never commit the real values.

# Razorpay — Dashboard > Settings > API Keys (https://dashboard.razorpay.com/app/keys)
# key_secret is server-only; never expose it to the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional, defaults to INR if unset.
RAZORPAY_CURRENCY=INR

# Razorpay webhook — Dashboard > Settings > Webhooks. Create a webhook there
# pointing at https://www.muzicllyglobal.com/api/webhooks/razorpay (once the
# domain is live) with events: payment.captured, payment.failed, order.paid,
# refund.created, refund.processed. The secret you set when creating it goes
# here — it's separate from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=

# Firebase Admin SDK — server-side credential for the SAME Firebase project
# ("muziclly-studio") the rest of the platform already uses for Auth +
# Firestore (see src/lib/firebase.ts). Generate one at:
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key. That download is a JSON file; copy its three fields below.
# Needed for the centralized payment layer (orders/payments/entitlements)
# and the Razorpay webhook to write authoritative records.
FIREBASE_ADMIN_PROJECT_ID=muziclly-studio
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the literal \n sequences from the downloaded JSON when pasting into
# a single-line env var (Vercel etc.) — the code converts them back to real
# newlines at runtime.
FIREBASE_ADMIN_PRIVATE_KEY=
